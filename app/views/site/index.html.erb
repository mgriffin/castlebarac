<%- content_for :title, "Home" %>
<section class="content col-md-8">
  <%- @competitions.each do |competition| %>
    <article class="card mb-3 competition-card">
      <div class="card-body">
        <h2 class="card-title"><%= link_to competition.name, competition_path(competition) %></h2>
        <div class="card-subtitle mb-2 text-body-tertiary">
          <%= l competition.date, format: :long %><%= " at #{competition.venue}" if competition.venue.present? %>
        </div>
        <p class="card-text">Entries are open until <strong><%= l competition.entries_close_at, format: :long %></strong>.</p>
        <%= link_to "Enter athletes", competition_entry_path(competition), class: "btn btn-primary" %>
      </div>
    </article>
  <%- end %>
  <%- if Castlebarac.show_about?(current_user) %>
    <article class="card mb-3">
      <div class="card-body">
        <span class="card-text">
          Castlebar Athletic Club is based in Castlebar in Co Mayo and caters mainly to kids between 8 and 18 years of age.
          We help athletes compete in track and field events as well as cross country races.
        </span>
      </div>
    </article>
  <%- end %>
  <%- @posts.each do |post| %>
    <article class="card mb-3">
      <div class="card-body">
        <h2 class="card-title"><%= link_to post.title, post_path(post) %></h2>
        <div class="card-subtitle mb-2 text-body-tertiary"><%= post.created_at.strftime("%b %-d, %Y") %></div>
        <span class="card-text">
          <%- if Castlebarac.truncate_post?(current_user) %>
            <%= post.content.to_plain_text.truncate(150) %>
            <br /><%= link_to "Read more", post_path(post) %>
          <%- else %>
            <%= post.content %>
          <%- end %>
        </span>
      </div>
    </article>
  <%- end %>
  <%= link_to "Older news >>", posts_path %>
</section>
<section class="sidebar col-md-4">
  <h2>Upcoming events</h2>
  <%- if @events.any? %>
    <ul class="upcoming-events">
      <%- @events.each do |event| %>
        <li>
          <%= link_to event_path(event), class: "upcoming-event" do %>
            <%= date_tile(event.start_time) %>
            <span>
              <span class="upcoming-event__title"><%= event.title %></span>
              <span class="upcoming-event__when"><%= event_when(event) %></span>
            </span>
          <%- end %>
        </li>
      <%- end %>
    </ul>
  <%- else %>
    <p>There are no events coming up</p>
  <%- end %>
</section>
