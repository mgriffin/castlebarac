<%- latest = child.results.max_by { it.race.event.start_time } %>
<div class="person-child">
  <%= person_avatar(child, small: true) %>
  <div>
    <%= link_to child.fullname, person_path(child), class: "person-child__name" %>
    <%- age_group = child.age_group if policy(child).private_details? %>
    <%= tag.span(age_group, class: "person-chip") if age_group %>
    <p>
      <%- if latest %>
        <%= pluralize(child.results.size, "result") %>, most recently
        <%= latest.race.event.title %> on <%= l(latest.race.event.start_time.to_date, format: :day_month_year) %>
      <%- else %>
        No results yet
      <%- end %>
    </p>
  </div>
</div>
