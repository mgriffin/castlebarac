<div class="content">
  <h1 class="h3">Parents and children</h1>
  <p>
    People who asked to be linked to their child. Anyone can type a child's name, so check that they're really the
    parent before approving. Approving lets them see the child's results and enter them into competitions.
  </p>

  <h2 class="h5">Waiting for approval</h2>
  <%- if @pending.empty? %>
    <p>There are no requests waiting.</p>
  <%- else %>
    <div class="table-responsive">
      <table class="table align-middle admin-table">
        <thead class="table-light">
          <tr>
            <th scope="col">Parent</th>
            <th scope="col">Child</th>
            <th scope="col">Child's other parents</th>
            <th scope="col">Asked</th>
            <th scope="col"><span class="visually-hidden">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <%- @pending.each do |claim| %>
            <tr id="<%= dom_id claim %>">
              <td>
                <div>
                  <%= claim.user.person ? link_to(claim.user.name, person_path(claim.user.person)) : claim.user.username %>
                </div>
                <div class="small text-body-secondary">
                  <%= link_to claim.user.email, admin_user_path(claim.user) %>, signed up on
                  <%= claim.user.created_at.to_date.to_fs(:long) %>
                </div>
              </td>
              <td>
                <%= link_to claim.child.fullname, person_path(claim.child) %>
                <%- if claim.child.year.present? %>
                  <span class="small text-body-secondary">(born <%= claim.child.year %>)</span>
                <%- end %>
              </td>
              <td>
                <%- if claim.child.parents.any? %>
                  <%= claim.child.parents.map(&:fullname).to_sentence %>
                <%- else %>
                  <span class="text-body-secondary">–</span>
                <%- end %>
              </td>
              <td><%= time_ago_in_words(claim.created_at) %> ago</td>
              <td class="text-end text-nowrap">
                <%= button_to "Approve", approve_admin_child_claim_path(claim), method: :patch,
                              class: "btn btn-sm btn-primary", form_class: "d-inline-block",
                              form: { data: { turbo_confirm: "Link #{claim.user.name || claim.user.email} as the parent of #{claim.child.fullname}?" } } %>
                <%= button_to "Reject", reject_admin_child_claim_path(claim), method: :patch,
                              class: "btn btn-sm btn-outline-danger", form_class: "d-inline-block" %>
              </td>
            </tr>
          <%- end %>
        </tbody>
      </table>
    </div>
  <%- end %>

  <%- if @reviewed.any? %>
    <h2 class="h5 mt-4">Recently reviewed</h2>
    <ul>
      <%- @reviewed.each do |claim| %>
        <li>
          <%= claim.user.email %> as the parent of <%= claim.child.fullname %>:
          <%= claim.status %> by <%= claim.reviewed_by&.name || "someone" %>
          <%= time_ago_in_words(claim.reviewed_at) %> ago
        </li>
      <%- end %>
    </ul>
  <%- end %>
</div>
