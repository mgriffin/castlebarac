<%= form_with model: [:admin, team, Membership.new],
  class: "mb-4 team-member-form",
  data: {
    controller: "autocomplete",
    autocomplete_url_value:  people_search_index_url
  } do |form| %>
  <%= form.label :person, "Add someone to the team", class: "form-label" %>
  <div class="d-flex gap-2 align-items-start">
    <div class="auto flex-grow-1">
      <%= form.text_field :person,
        class: "form-control",
        placeholder: "Start typing a name",
        required: true,
        autofocus: true,
        autocomplete: "off",
        data: {
          autocomplete_target: "input"
        } %>
      <%= form.hidden_field :person_id, data: { autocomplete_target: "hidden" } %>
      <ul class="autocomplete" data-autocomplete-target="results"></ul>
    </div>
    <%= form.submit "Add them", class: "btn btn-primary text-nowrap" %>
  </div>
<% end %>
