<div class="content">
  <h1><%= @team.name %></h1>
  <%= render "admin/teams/memberships/form", team: @team %>
  <%- if @memberships.empty? %>
    <p>There are no members of this team</p>
  <%- else %>
    <h3>Members</h3>
    <ul>
      <%- @memberships.each do |membership| %>
        <li>
          <%= membership.person.fullname %>
          <%- if @team.name == "Admins" && membership.person == current_user.person %>
            <span class="small text-body-secondary ms-1">(you)</span>
          <%- else %>
            <%= button_to "Remove", admin_team_membership_path(@team, membership), method: :delete,
                          form_class: "d-inline ms-1", class: "btn btn-sm btn-outline-danger",
                          data: { turbo_confirm: "Remove #{membership.person.fullname} from #{@team.name}?" } %>
          <%- end %>
        </li>
      <%- end %>
    </ul>
  <%- end %>
</div>
