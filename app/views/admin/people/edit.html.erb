<div class="content">
  <h1>Editing person</h1>
  <%- if @person.aai_number || @person.member_years.any? %>
    <p class="text-body-secondary">
      <%- if @person.aai_number %>AAI number <%= @person.aai_number %>.<%- end %>
      <%- if @person.member_years.any? %>Member in <%= @person.member_years.to_sentence %>.<%- end %>
    </p>
  <%- end %>

  <%= render "form", person: @person %>
  <%= render "admin/people/relationships/form", parent: @person %>
  <%= render "admin/people/accounts/form", person: @person %>
</div>
