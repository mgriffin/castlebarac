<%= form_with model: [:admin, competition], data: { controller: "nested-fields" } do |form| %>
  <%- if competition.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <%- competition.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <%- end %>
      </ul>
    </div>
  <%- end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, required: true, autofocus: true, class: "form-control",
                               placeholder: "Connacht Juvenile Championships" %>
  </div>

  <div class="row">
    <div class="col-md-4 mb-3">
      <%= form.label :level, class: "form-label" %>
      <%= form.select :level, Competition::LEVELS.map { [it.humanize, it] }, {}, class: "form-select" %>
    </div>
    <div class="col-md-8 mb-3">
      <%= form.label :venue, class: "form-label" %>
      <%= form.text_field :venue, class: "form-control" %>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= form.label :date, "Date of the competition", class: "form-label" %>
      <%= form.date_field :date, required: true, class: "form-control" %>
    </div>
    <div class="col-md-6 mb-3">
      <%= form.label :entries_close_at, class: "form-label" %>
      <%= form.datetime_local_field :entries_close_at, required: true, class: "form-control" %>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= form.label :fee_per_event, "Fee per event (€)", class: "form-label" %>
      <%= form.number_field :fee_per_event, value: format("%.2f", competition.fee_per_event),
                                            min: 0, step: 0.01, class: "form-control" %>
      <div class="form-text">Charged for each athlete in each event</div>
    </div>
    <div class="col-md-6 mb-3">
      <%= form.label :max_events_per_athlete, class: "form-label" %>
      <%= form.number_field :max_events_per_athlete, min: 1, class: "form-control" %>
      <div class="form-text">Leave blank if there's no limit</div>
    </div>
  </div>

  <div class="mb-3">
    <%= form.label :description, class: "form-label" %>
    <%= rich_text_editor(form, :description) %>
    <div class="form-text">Shown to parents and included in the reminder email</div>
  </div>

  <div class="mb-3">
    <%= form.label :event_id, "Results", class: "form-label" %>
    <%= form.collection_select :event_id, Event.order(start_time: :desc).limit(50), :id, :title,
                               { include_blank: "Not linked yet" }, class: "form-select" %>
    <div class="form-text">Link the results once they're imported</div>
  </div>

  <h2 class="h4 mt-4">Events</h2>
  <p class="form-text">
    Ages are the athlete's age on 31 December. They're filled in from age groups like "U12"
    if left blank.
  </p>

  <div data-nested-fields-target="fields">
    <%= form.fields_for :competition_events do |event_form| %>
      <%= render "competition_event_fields", form: event_form %>
    <%- end %>
  </div>

  <div class="mb-3">
    <%= button_tag "Add an event", type: :button, data: { action: "nested-fields#append" },
                                   class: "btn btn-secondary" %>
    <template data-nested-fields-target="template">
      <%= fields_for "competition[competition_events_attributes][]", CompetitionEvent.new,
                     index: "__INDEX__" do |event_form| %>
        <%= render "competition_event_fields", form: event_form %>
      <%- end %>
    </template>
  </div>

  <hr>

  <%= form.submit "Save", class: "btn btn-primary" %>
<% end %>
