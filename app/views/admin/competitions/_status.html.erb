<%- if competition.accepting_entries? %>
  <span class="badge text-bg-success">Open until <%= l competition.entries_close_at, format: :short %></span>
<%- elsif !competition.entries_draft? %>
  <span class="badge text-bg-secondary">Closed</span>
<%- else %>
  <span class="badge text-bg-light">Not open yet</span>
<%- end %>
