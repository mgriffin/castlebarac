<%= turbo_frame_tag user do %>
  <%- if user.name.nil? %>
    <span class="text-body-secondary">–</span>
  <%- else %>
    <%= user.name %>
    <%= link_to person_path(user.person), class: "ms-1", title: "View profile",
                                          aria: { label: "View #{user.name}'s profile" },
                                          data: { turbo_frame: "_top" } do
      inline_svg_tag "eye.svg"
    end %>
    <%= link_to edit_admin_person_path(user.person), class: "ms-1", title: "Edit person",
                                                     aria: { label: "Edit #{user.name}" },
                                                     data: { turbo_frame: "_top" } do
      inline_svg_tag "rocket.svg"
    end %>
  <%- end %>
<%- end %>
