<div class="content">
  <div class="d-flex align-items-baseline justify-content-between mb-3">
    <h1 class="h3 mb-0">Users</h1>
    <span class="text-body-secondary"><%= pluralize(@users.size, "user") %></span>
  </div>

  <div class="table-responsive">
    <table class="table table-hover align-middle users-table">
      <thead class="table-light">
        <tr>
          <th scope="col">User</th>
          <th scope="col">Name</th>
          <th scope="col">Signed up</th>
          <th scope="col">Last logged in</th>
          <th scope="col">Admin?</th>
          <th scope="col"><span class="visually-hidden">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        <%- @users.each do |user| %>
          <tr>
            <td>
              <div><%= user.email %></div>
              <div class="small text-body-secondary">#<%= user.id %></div>
            </td>
            <td><%= render "name", user: user %></td>
            <td class="text-nowrap"><%= time_ago_tag(user.created_at) %></td>
            <td class="text-nowrap">
              <%= time_ago_tag(user.current_sign_in_at) || tag.span("Not recorded", class: "text-body-secondary") %>
            </td>
            <td class="text-nowrap">
              <%- if @admin_person_ids.include?(user.person&.id) %>
                <span class="badge text-bg-success">Admin</span>
                <%- if user == current_user %>
                  <span class="small text-body-secondary ms-1">(you)</span>
                <%- else %>
                  <%= button_to "Remove", admin_user_admin_membership_path(user), method: :delete,
                                form_class: "d-inline ms-1", class: "btn btn-sm btn-outline-danger",
                                data: { turbo_confirm: "Remove #{user.name} from the Admins team?" } %>
                <%- end %>
              <%- elsif user.person %>
                <%= button_to "Make admin", admin_user_admin_membership_path(user),
                              class: "btn btn-sm btn-outline-primary" %>
              <%- else %>
                <span class="small text-body-secondary" title="Only people can be in the Admins team">
                  No person linked
                </span>
              <%- end %>
            </td>
            <td class="text-end">
              <%= button_to "Impersonate", impersonate_admin_user_path(user),
                            data: { turbo: false }, class: "btn btn-sm btn-outline-secondary" %>
            </td>
          </tr>
        <%- end %>
      </tbody>
    </table>
  </div>
</div>
