<!DOCTYPE html>
<html>
  <head>
    <title>Castlebar A.C.<%= " - #{yield :title}" if content_for?(:title) %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="turbo-prefetch" content="false">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%= stylesheet_link_tag "bootstrap.min", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "sporty", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "rhinoeditor", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <%= auto_discovery_link_tag(:rss, rss_url, {title: "RSS Feed"}) %>
  </head>
  <body>
    <div class="container">
      <%= render AdminToolbarComponent.new(user: current_user) %>
      <% if current_user != true_user %>
        <div class="impersonate-bar" aria-label="Impersonation toolbar">
          <%= inline_svg_tag "circle-slash.svg" %>
          <%= link_to "Stop impersonating #{current_user.name}", impersonation_path, data: {turbo_method: :delete} %>
        </div>
      <% end %>
      <header class="row">
        <%= link_to root_path, class: "logo col" do %>
          <%= inline_svg_tag "shield.svg" %>
        <%- end %>
        <span class="col">Castlebar A.C.</span>
      </header>
      <nav id="main-nav" aria-label="Main Navigation" class="row navbar navbar-expand-sm">
        <div class="container-fluid">
          <div class="navbar-nav">
            <%= link_to "Home", root_path, class: "nav-link" %>
            <%= link_to "News", posts_path, class: "nav-link" %>
            <%= link_to "Events", events_path, class: "nav-link" %>
            <%= link_to "Training Times", training_times_path, class: "nav-link" %>
            <%- if user_signed_in? %>
              <%- if current_user.coach? %>
                <%= link_to "Coaches Corner", coaches_path, class: "nav-link" %>
              <%- end %>
              <%- if Castlebarac.competition_entries?(current_user) && policy([:admin, Competition]).index? %>
                <%= link_to "Manage competitions", admin_competitions_path, class: "nav-link" %>
              <%- end %>
              <%- if policy([:admin, ClubMembership]).index? %>
                <%= link_to "Members", admin_members_path, class: "nav-link" %>
              <%- end %>
              <%= link_to "My Profile", profile_path, class: "nav-link" %>
              <%= link_to "Log out", destroy_user_session_path, data: { "turbo-method": :delete }, class: "nav-link" %>
            <%- else %>
              <%= link_to "Log in", new_user_session_path, class: "nav-link" %>
            <%- end %>
          </div>
        </div>
      </nav>
      <section class="main row py-3">
        <%= render FlashComponent.new(flash: flash) %>
        <%= render FillOutProfileComponent.new(user: current_user) %>
        <%= yield %>
      </section>
      <footer id="site-footer" class="row">
        &copy; <%= Date.current.year %> Castlebar AC
      </footer>
    </div>
  </body>
</html>
