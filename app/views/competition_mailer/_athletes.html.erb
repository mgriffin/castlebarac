<%- lines_by_person.each do |person, lines| %>
  <p><strong><%= person.fullname %></strong></p>
  <ul>
    <%- lines.each do |line| %>
      <li><%= line.competition_event.name %><%= " at #{line.competition_event.start_time.strftime('%H:%M')}" if line.competition_event.start_time %></li>
    <%- end %>
  </ul>
<%- end %>
