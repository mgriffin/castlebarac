<% content_for :title, "Competitions" %>
<div class="content">
  <h1>Competitions</h1>

  <%- if @competitions.empty? %>
    <p>There are no competitions coming up.</p>
  <%- else %>
    <%- @competitions.each do |competition| %>
      <article class="mb-4">
        <h2 class="h4 mb-1"><%= link_to competition.name, competition_path(competition) %></h2>
        <p class="subtle mb-1">
          <%= l competition.date, format: :long %><%= " at #{competition.venue}" if competition.venue.present? %>
        </p>
        <%= render "entries_status", competition: %>
      </article>
    <%- end %>
  <%- end %>
</div>
