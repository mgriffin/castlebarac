<% content_for :title, "Your entry for #{@competition.name}" %>
<div class="content">
  <h1>Your entry</h1>
  <p class="subtle">
    <%= link_to @competition.name, competition_path(@competition) %>, <%= l @competition.date, format: :long %>
  </p>

  <%- if @competition.accepting_entries? %>
    <p>Entries close <strong><%= l @competition.entries_close_at, format: :long %></strong>.</p>
  <%- else %>
    <p>Entries are closed, so this entry can't be changed.</p>
  <%- end %>

  <%- lines_by_person = @entry.persisted? ? @entry.lines_by_person : {} %>
  <%- if lines_by_person.empty? %>
    <p>You haven't entered anyone yet.</p>
  <%- else %>
    <%- lines_by_person.each do |person, lines| %>
      <section class="card mb-3 entry-athlete">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <h2 class="h5 card-title"><%= person.fullname %></h2>
            <%- if @competition.accepting_entries? %>
              <div class="d-flex gap-2">
                <%= link_to "Change events", competition_entry_athlete_path(@competition, person.id),
                            class: "btn btn-sm btn-outline-secondary" %>
                <%= button_to "Remove", competition_entry_athlete_path(@competition, person.id),
                              method: :delete, class: "btn btn-sm btn-outline-danger",
                              form: { data: { turbo_confirm: "Remove #{person.firstname} from this competition?" } } %>
              </div>
            <%- end %>
          </div>
          <ul class="mb-0">
            <%- lines.each do |line| %>
              <li><%= line.competition_event.name %></li>
            <%- end %>
          </ul>
        </div>
      </section>
    <%- end %>
  <%- end %>

  <%- if @competition.accepting_entries? %>
    <div class="d-flex flex-wrap gap-2">
      <%= link_to lines_by_person.empty? ? "Add an athlete" : "Add another athlete",
                  new_competition_entry_athlete_path(@competition), class: "btn btn-outline-primary" %>
    </div>
  <%- end %>
</div>
