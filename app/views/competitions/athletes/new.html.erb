<% content_for :title, "Choose an athlete" %>
<div class="content">
  <h1>Who are you entering?</h1>
  <p class="subtle"><%= @competition.name %></p>

  <%- if @linked_people.any? %>
    <div class="d-flex flex-wrap gap-2 mb-4">
      <%- @linked_people.each do |person| %>
        <%= link_to person.fullname, competition_entry_athlete_path(@competition, person.id),
                    class: "btn btn-outline-primary" %>
      <%- end %>
    </div>

    <p>
      You can enter yourself and your children. Not seeing one of them?
      <%= link_to "Link your child to your account", new_profile_child_claim_path %>, and once an admin has checked,
      you can enter them here.
    </p>
  <%- else %>
    <p>
      You can enter yourself and your children.
      <%= link_to "Fill out your details", new_profile_path %> first, and then you can link your children to your
      account.
    </p>
  <%- end %>
</div>
